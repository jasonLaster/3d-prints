  "audit": {
    "toleranceMm": 0.2,
    "dimensionTargets": [
      "The default target mortise is 8 × 30 mm with a 6 mm cutter and 16 mm guide bushing.",
      "The default guide opening is 18.25 × 40.25 mm after adding 0.25 mm of total template wiggle room.",
      "The 220 × 120 × 12 mm guide plate spans 20–80 mm workpieces.",
      "Two 190 × 14 × 24 mm fence jaws each receive two M5 heat-set inserts.",
      "Four one-click mortise presets cover 6 × 25, 8 × 30, 10 × 40, and 12 × 50 mm targets."
    ],
    "invariants": [
      "Derive the template opening from mortise + guide-bushing diameter − cutter diameter + total wiggle room.",
      "Keep the cutter no larger than the mortise width and maintain radial clearance inside the guide bushing.",
      "Keep four independent M5 adjustment slots aligned with two heat-set insert pockets in each fence jaw.",
      "Keep at least 2.5 mm around every insert pocket and at least 3 mm beneath each blind pocket.",
      "Keep common 38, 50, 64, and 76 mm stock-width witness marks beside the adjustment slots.",
      "Export the guide plate and both fence jaws as individual, support-free STL files.",
      "Treat the router base, guide bushing, cutter, and workpiece as preview-only stand-ins rather than printable jig parts.",
      "Test the jig on scrap, clamp the work securely, use shallow passes, and follow the router and cutter manufacturers' instructions."
