  "audit": {
    "toleranceMm": 0.2,
    "dimensionTargets": [
      "The default wood base is 420 × 320 × 18 mm with a centered 1.5 mm blade kerf.",
      "The default sacrificial wood fence is 380 × 100 × 18 mm and moves continuously over the two 52 mm bracket slots.",
      "The printed bracket length adjusts through 203.2 mm (8 in), independently of the triangular gusset length.",
      "The default 90 mm bracket uses a 62 mm gusset; an 8 in bracket can use a 101.6 mm (4 in) gusset to conserve filament.",
      "Four M5 × 25 mm bolts fasten the wood fence into four heat-set inserts in the printed brackets.",
      "Two captive M6 × 25 mm knob bolts lock into two 10 × 13 mm screw-in inserts in the wooden base."
    ],
    "invariants": [
      "Keep the base, fence, and runner as wood fabrication parts; export only the brackets and lock knobs as STLs.",
      "Use two widely spaced brackets so the fence cannot yaw around a single lock point.",
      "Keep the fence position inside both continuous lock-slot ranges.",
      "Preserve four M5 heat-set insert pockets, two screw-in M6 wood-insert holes, and their bolt engagement depths.",
      "Keep at least 12 mm of printed plastic beyond every M6 slot end and at least 4 mm of wood beneath each base insert.",
      "Keep each gusset shorter than the bracket foot and keep the full bracket foot supported by the selected wood-base depth at its nominal fence position.",
      "Keep the blade kerf centered through the base and sacrificial fence.",
      "Treat the structural calculations as conservative screens, not certification; test squareness and locking on scrap before cutting workpieces."
    ],
    "checks": [
      { "key": "materials", "label": "Material separation" },
      { "key": "sledEnvelope", "label": "Wood sled envelope" },
