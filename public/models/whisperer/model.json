{
  "id": "whisperer",
  "name": "Whisperer",
  "subtitle": "Plan-derived MCM dining table",
  "description": "A parametric 1:10 model of the 72 × 40 inch mid-century dining table: a deeply beveled 1 3/4 inch top, four 15-degree splayed and tapered legs, and a recessed four-apron frame.",
  "viewer": "dining-table-v1",
  "stl": {
    "fileName": "whisperer.stl",
    "sourceName": "procedural-whisperer-default.stl",
    "units": "mm",
    "url": "/models/whisperer/whisperer.stl"
  },
  "export": {
    "filePrefix": "whisperer"
  },
  "geometry": {
    "mainAxis": { "x": 0, "y": 0, "z": 0 },
    "cornerSegments": 1,
    "edgeProfileSegments": 2,
    "channelCount": 0,
    "legSplayDegrees": 15,
    "longApronEndAngleDegrees": 18,
    "sideApronEdgeAngleDegrees": 15,
    "sideApronBottomChamferDegrees": 30
  },
  "parameters": [
    {
      "key": "mockScale",
      "label": "Mock scale denominator",
      "group": "Overall",
      "statusLabel": "Scale 1:",
      "default": 10,
      "limits": { "min": 6, "max": 24, "step": 1 }
    },
    {
      "key": "tableLength",
      "label": "Table length",
      "group": "Overall",
      "statusLabel": "Length",
      "default": 1828.8,
      "limits": { "min": 1524, "max": 2438.4, "step": 25.4 }
    },
    {
      "key": "tableWidth",
      "label": "Table width",
      "group": "Overall",
      "statusLabel": "Width",
      "default": 1016,
      "limits": { "min": 762, "max": 1219.2, "step": 25.4 }
    },
    {
      "key": "overallHeight",
      "label": "Overall height",
      "group": "Overall",
      "statusLabel": "Height",
      "default": 762,
      "limits": { "min": 685.8, "max": 812.8, "step": 6.35 }
    },
    {
      "key": "topThickness",
      "label": "Tabletop thickness",
      "group": "Tabletop",
      "default": 44.45,
      "limits": { "min": 25.4, "max": 63.5, "step": 3.175 }
    },
    {
      "key": "topEdgeThickness",
      "label": "Tabletop perimeter thickness",
      "group": "Tabletop",
      "default": 12.7,
      "limits": { "min": 6.35, "max": 38.1, "step": 1.5875 }
    },
    {
      "key": "undersideBevelInset",
      "label": "Underside bevel inset",
      "group": "Tabletop",
      "default": 127,
      "limits": { "min": 50.8, "max": 254, "step": 6.35 }
    },
    {
      "key": "legTopWidth",
      "label": "Leg width at top",
      "group": "Legs",
      "default": 101.6,
      "limits": { "min": 63.5, "max": 152.4, "step": 3.175 }
    },
    {
      "key": "legFootWidth",
      "label": "Leg width at foot",
      "group": "Legs",
      "default": 60.325,
      "limits": { "min": 38.1, "max": 101.6, "step": 1.5875 }
    },
    {
      "key": "legThickness",
      "label": "Leg thickness",
      "group": "Legs",
      "default": 44.45,
      "limits": { "min": 31.75, "max": 63.5, "step": 1.5875 }
    },
    {
      "key": "legFootChamfer",
      "label": "Foot corner chamfer",
      "group": "Legs",
      "default": 12.7,
      "limits": { "min": 3.175, "max": 19.05, "step": 1.5875 }
    },
    {
      "key": "longApronLength",
      "label": "Long apron length",
      "group": "Aprons",
      "default": 1327.15,
      "limits": { "min": 1016, "max": 1828.8, "step": 6.35 }
    },
    {
      "key": "longApronHeight",
      "label": "Long apron height",
      "group": "Aprons",
      "default": 88.9,
      "limits": { "min": 50.8, "max": 152.4, "step": 3.175 }
    },
    {
      "key": "sideApronLength",
      "label": "Side apron length",
      "group": "Aprons",
      "default": 647.7,
      "limits": { "min": 457.2, "max": 1016, "step": 6.35 }
    },
    {
      "key": "sideApronHeight",
      "label": "Side apron height",
      "group": "Aprons",
      "default": 101.6,
      "limits": { "min": 50.8, "max": 152.4, "step": 3.175 }
    },
    {
      "key": "apronThickness",
      "label": "Apron thickness",
      "group": "Aprons",
      "default": 38.1,
      "limits": { "min": 25.4, "max": 50.8, "step": 1.5875 }
    },
    {
      "key": "apronSetback",
      "label": "Apron setback from leg face",
      "group": "Aprons",
      "default": 6.35,
      "limits": { "min": 3.175, "max": 19.05, "step": 1.5875 }
    }
  ],
  "audit": {
    "toleranceMm": 0.5,
    "dimensionTargets": [
      "The tabletop is 72 in long by 40 in wide by 1 3/4 in thick, with a 5 in underside bevel that leaves a 1/2 in perimeter edge.",
      "Four 1 3/4 in thick legs use 29 1/4 in blanks, splay at 15 degrees, and taper from 4 in at the top to 2 3/8 in at the foot.",
      "The leg-foot corner chamfers are 1/2 in at the floor and taper to zero toward the top.",
      "Two 52 1/4 × 3 1/2 × 1 1/2 in long aprons use 18-degree end details and a 45-degree bottom chamfer.",
      "Two 25 1/2 × 4 × 1 1/2 in side aprons follow the 15-degree leg assembly and use a 30-degree bottom-edge chamfer.",
      "All four aprons are recessed 1/4 in from the leg faces."
    ],
    "invariants": [
      "Keep the full-size furniture dimensions independent from the mock scale denominator.",
      "Keep the tabletop, each leg, and every apron as a closed printable solid.",
      "Keep the four legs mirrored in pairs and preserve the 15-degree longitudinal splay.",
      "Keep each foot inside the 72 × 40 in tabletop plan envelope at the default dimensions.",
      "Keep the apron tops registered to the tabletop underside and the apron faces recessed from the leg faces.",
      "Keep the top underside bevel centered and leave a positive flat center field.",
      "Treat the PDF as the dimensional source while leaving joinery that is not dimensioned in the plan out of the visual model.",
      "Export one same-origin wood STL because the plan does not specify separate metal hardware."
    ],
    "checks": [
      { "key": "tableEnvelope", "label": "Plan envelope" },
      { "key": "tabletopProfile", "label": "Beveled tabletop profile" },
      { "key": "legGeometry", "label": "Splayed leg geometry" },
      { "key": "legEndRoundovers", "label": "Foot taper detail" },
      { "key": "cornerPlates", "label": "Apron assembly" },
      { "key": "channelLayout", "label": "Nine-part cut list" },
      { "key": "printEnvelope", "label": "Mock print envelope" },
      { "key": "minimumMockFeature", "label": "Smallest mock feature" }
    ]
  },
  "scripts": [
    {
      "name": "audit",
      "path": "models/whisperer/audit.mjs",
      "command": "npm run audit -- whisperer",
      "description": "Validates the plan dimensions, splayed-frame relationships, and procedural model contract."
    }
  ]
}
