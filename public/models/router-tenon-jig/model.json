  "audit": {
    "toleranceMm": 0.2,
    "dimensionTargets": [
      "The default centered tenon is 10 mm thick × 40 mm wide × 30 mm long on 64 × 38 mm stock.",
      "A 12.7 mm cutter and equal 12.7 mm guide bearing make the default guide openings 10.2 × 40.2 mm after adding 0.2 mm of total extra material.",
      "The 210 × 170 mm bridge has a 12 mm recessed floor, 22 mm flush support surface, 96 × 64 mm stock throat, and eight blind M5 insert pockets.",
      "Two 70 × 110 × 10 mm cheek guides or two 100 × 52 × 10 mm edge guides seat in the matching recess one opposing pair at a time.",
      "Four one-click preset markers cover 6 × 30 × 25 through 12 × 50 × 35 mm tenons."
    ],
    "invariants": [
      "Derive each external bearing-guide opening as target tenon + total extra material − guide-bearing diameter + cutter diameter.",
      "Keep at least 3 mm of shoulder on every side of the selected tenon.",
      "Keep eight M5 heat-set insert pockets blind with at least 3 mm of floor and 3 mm of side web.",
      "Use two fasteners per guide plate so no guide can pivot around a single screw.",
      "Keep thickness witness marks at 6, 8, 10, and 12 mm and width witness marks at 30, 40, 50, and 60 mm.",
      "Export the bridge and four sliding guides as five individual, support-free STL files.",
      "Treat the router auxiliary sub-base, bearing bit, hose-band depth stop, inserts, and workpiece as preview-only stand-ins.",
      "Install only the selected opposing guide pair; its top must remain flush with the raised router-support surface.",
      "Keep the modeled auxiliary router sub-base engaged with the active guide and at least one raised corner support region.",
      "Keep the geometry-only base and guide deflection screens below 0.3 mm with a safety factor above 4 under the configured 75 N comparison load.",
      "Clamp the jig and stock, check rotation direction and clearance, take shallow conventional passes, and follow the router and bit manufacturers' instructions."
    ],
    "checks": [
      { "key": "tenonTarget", "label": "Tenon target" },
