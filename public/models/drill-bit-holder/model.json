    "defaultBitDiametersMm": [3.175, 3.96875, 4.7625, 6.35, 7.9375, 9.525, 12.7],
    "minimumBitDiameter": 0.79375,
    "maximumBitDiameter": 25.4,
    "maximumBitCount": 24,
    "radialSegments": 64,
