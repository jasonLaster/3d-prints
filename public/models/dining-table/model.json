{
  "id": "dining-table",
  "name": "Oak Dining Table",
  "subtitle": "Parametric 1:10 construction mock",
  "description": "A dimension-driven apronless oak dining table with rounded tabletop and posts, softened post ends, flush inset 6-inch corner plates, and three recessed C-channels.",
  "viewer": "dining-table-v1",
  "stl": {
    "fileName": "dining-table.stl",
    "sourceName": "procedural-dining-table-seed.stl",
    "units": "mm",
    "url": "/models/dining-table/dining-table.stl"
  },
  "export": {
    "filePrefix": "dining-table"
  },
  "geometry": {
    "mainAxis": { "x": 0, "y": 0, "z": 0 },
    "cornerSegments": 12,
    "edgeProfileSegments": 8,
    "channelCount": 3
  },
  "parameters": [
    {
      "key": "mockScale",
      "label": "Mock scale denominator",
      "statusLabel": "Scale 1:",
      "default": 10,
      "limits": { "min": 6, "max": 24, "step": 1 }
    },
    {
      "key": "tableLength",
      "label": "Table length",
      "statusLabel": "Length",
      "default": 1930.4,
      "limits": { "min": 1219.2, "max": 2438.4, "step": 25.4 }
    },
    {
      "key": "tableWidth",
      "label": "Table width",
      "statusLabel": "Width",
      "default": 965.2,
      "limits": { "min": 762, "max": 1219.2, "step": 25.4 }
    },
    {
      "key": "overallHeight",
      "label": "Overall height",
      "statusLabel": "Height",
      "default": 762,
      "limits": { "min": 635, "max": 914.4, "step": 12.7 }
    },
    {
      "key": "topThickness",
      "label": "Tabletop thickness",
      "default": 38.1,
      "limits": { "min": 25.4, "max": 76.2, "step": 3.175 }
    },
    {
      "key": "tabletopCornerRadius",
      "label": "Tabletop corner radius",
      "default": 25.4,
      "limits": { "min": 6.35, "max": 152.4, "step": 3.175 }
    },
    {
      "key": "topRoundoverRadius",
      "label": "Top edge roundover radius",
      "default": 12.7,
      "limits": { "min": 1.5875, "max": 38.1, "step": 1.5875 }
    },
    {
