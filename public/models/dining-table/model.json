  "audit": {
    "toleranceMm": 0.5,
    "dimensionTargets": [
      "The full-size tabletop is 76 in long by 38 in wide by 1 1/2 in thick, and the finished table is 30 in high.",
      "Four 4 in square posts use 1 in vertical corner radii and meet a tabletop with 1 in plan-view corner radii.",
      "The tabletop has 1/2 in top and bottom roundovers, leaving a 1/2 in flat vertical edge band.",
      "Each post has a 1/4 in horizontal edge roundover at both its top and bottom ends, with no routed reveal or rabbet.",
      "Four 6 in square by 1/4 in steel plates are set 1/2 in back from both tabletop edges, and exactly three widthwise C-channels are flush with the tabletop underside.",
      "The default 1:10 mock fits inside a 256 mm square printer bed footprint."
    ],
    "invariants": [
      "Keep the real furniture dimensions independent from the mock scale denominator.",
      "Keep the tabletop and all four leg solids closed and printable.",
      "Keep each post continuous and groove-free, using top and bottom end roundovers for the shadow transition and softened foot.",
      "Keep all four steel plate faces and three C-channel faces coplanar with the tabletop underside.",
      "Keep every plate edge set back from the tabletop side and end so no steel is visible in a normal side elevation.",
      "Keep the leg outer faces aligned to the tabletop edges when leg edge inset is zero.",
      "Keep the three C-channel positions ordered from the first end of the table.",
      "Keep top and bottom roundover radii within half the tabletop thickness.",
      "Treat oak grain and steel finish as render materials; dimensions come only from procedural geometry."
    ],
    "checks": [
      { "key": "tableEnvelope", "label": "Full-size envelope" },
      { "key": "tabletopProfile", "label": "Tabletop edge profile" },
      { "key": "legGeometry", "label": "Leg geometry" },
      { "key": "legEndRoundovers", "label": "Leg end roundovers" },
      { "key": "cornerPlates", "label": "Corner plates" },
      { "key": "channelLayout", "label": "Three C-channels" },
      { "key": "printEnvelope", "label": "Mock print envelope" },
      { "key": "minimumMockFeature", "label": "Smallest mock feature" }
    ]
  },
  "scripts": [
    {
      "name": "audit",
      "path": "models/dining-table/audit.mjs",
      "command": "npm run audit -- dining-table",
      "description": "Validates the furniture dimensions, scale mock, hardware layout, and procedural model contract."
    }
  ]
}
