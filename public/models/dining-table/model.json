    },
    {
      "key": "legSize",
      "label": "Leg post size",
      "default": 101.6,
      "limits": { "min": 63.5, "max": 152.4, "step": 6.35 }
    },
    {
      "key": "legCornerRadius",
      "label": "Leg corner radius",
      "default": 25.4,
      "limits": { "min": 3.175, "max": 50.8, "step": 3.175 }
    },
